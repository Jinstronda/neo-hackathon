# Copy to .env and fill in. .env is untracked; never commit it.

# LLM gateway (OpenAI-compatible). Every model call in NEO goes through it.
HOMODEUS_API_KEY=hd_xxx
NEO_GATEWAY_BASE=https://your-llm-gateway.example/v1

# Red swarm: open-weight models running on our own EU servers, comma-separated,
# in order. The real ids live only in your untracked .env; the public UI and the
# logs show them as model-1..model-n. `neo run --swarm N` takes the first N of
# NEO_RED_SWARM followed by NEO_RED_SWARM_EXTRA (up to five).
NEO_RED_SWARM=provider/open-weight-model-a,provider/open-weight-model-b,provider/open-weight-model-c
NEO_RED_SWARM_EXTRA=provider/open-weight-model-d,provider/open-weight-model-e

# Optional overrides for the blue fixer, the two reviewers and the chat agent
# (defaults in neo/config.py).
# NEO_BLUE_FIXER=
# NEO_REVIEWER_SECURITY=
# NEO_REVIEWER_CORRECTNESS=
# NEO_CHAT_MODEL=

# Twin host provided by the hackathon organizer, for our own disposable twins only.
TWIN_SSH_HOST=
TWIN_SSH_USER=ubuntu
TWIN_SSH_PASS=

# GitHub repo the blue agent opens PRs against (owner/name). `--local` skips GitHub.
NEO_REPO=Jinstronda/neo-hackathon

# GitHub token for the real PR route. Optional on a dev box logged in with `gh auth login`.
GH_TOKEN=
